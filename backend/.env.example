# Server Port
PORT=5000

# Allowed CORS Origins (comma-separated for multiple origins, e.g. for Vercel deployment)
# Example: ALLOWED_ORIGINS=https://flowsight.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Explanation Providers (Optional - FlowSight works 100% offline without any keys)
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
AI_MODEL=
